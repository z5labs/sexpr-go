(define (map f xs)
  (if (null? xs)
      nil
      (cons (f (car xs)) (map f (cdr xs)))))

(define quoted '(a b c))
(define template `(head ,value ,@rest))

(define (describe x)
  (cond
    ((null? x) "empty")
    ((pair? x) "a pair")
    (#t        "something else")))

(define constants
  (list 0 -1 +42 1.5 -0.5 1e10 1.5e-3 .5))
